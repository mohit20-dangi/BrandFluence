<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/filterCategory"
        android:hint="Category (e.g., Fashion)"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/filterMinFollowers"
        android:hint="Min Followers"
        android:inputType="number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Platform:"/>

    <Spinner
        android:id="@+id/filterPlatformSpinner"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:spinnerMode="dropdown"/>

    <Button
        android:id="@+id/applyFilterBtn"
        android:text="Apply Filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
